@model IEnumerable<ClassicCarsWeb.Models.TestDriveRequest>

@{
    ViewData["Title"] = "Test Drive Bookings";
}

<div class="container mt-4">
    <h2 class="text-white mb-4">Test Drive Bookings</h2>

    <div class="table-responsive">
        <table class="table table-dark table-hover border-secondary">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Car Model</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>@item.CustomerName</td>
                        <td>@item.CarModel</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Email</td>
                        <td>@item.Address</td>
                        <td>@item.BookingDate.ToString("MMMM dd, yyyy")</td>
                        <td>
                            <form asp-action="DeleteBooking" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this booking?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>