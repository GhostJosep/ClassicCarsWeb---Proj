@model IEnumerable<ClassicCarsWeb.Models.TestDriveRequest>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Customer Name</th>
            <th>Car Model</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.CustomerName</td>
                <td>@request.CarModel</td>
                <td>@request.PhoneNumber</td>
                <td>@request.Email</td>
                <td>@request.BookingDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>