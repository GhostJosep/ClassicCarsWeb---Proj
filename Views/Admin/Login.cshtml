<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card p-4 shadow-sm" style="width: 100%; max-width: 400px; background-color: #1a1a1a; color: white;">
        <h3 class="text-center mb-4">Admin Access</h3>
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <input type="text" name="username" class="form-control bg-dark text-white border-secondary" placeholder="Username" required />
            </div>
            <div class="mb-3">
                <input type="password" name="password" class="form-control bg-dark text-white border-secondary" placeholder="Password" required />
            </div>
            <button type="submit" class="btn btn-danger w-100">Sign In</button>
        </form>
        @if(ViewBag.Error != null) { 
            <p class="text-danger text-center mt-3">@ViewBag.Error</p> 
        }
    </div>
</div>