@model IEnumerable<ClassicCarsWeb.Models.TestDriveRequest>

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="container mt-5">
    <h2 class="text-white">Manager Dashboard</h2>
    <hr class="border-secondary" />
    
    @if (!Model.Any()) {
        <p class="text-muted">No test drive requests found.</p>
    } else {
        <div class="table-responsive">
            <table class="table table-dark table-hover border-secondary">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Car</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td>@item.CustomerName</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Address</td>
                            <td>@item.CarModel</td>
                            <td>@item.BookingDate.ToString("MMMM dd, yyyy")</td>
                            <td>
                                <form asp-controller="Booking" asp-action="DeleteBooking" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this record?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>